# ─── Aplicación ────────────────────────────────────────────────────
# APP_URL: URL pública completa, sin barra final.
#   - Dominio raíz:      https://tudominio.com
#   - Subdirectorio:     https://tudominio.com/crm
#   - Si la dejas vacía, la app la detecta automáticamente.
APP_URL=
APP_NAME=CRM
APP_DEBUG=false
APP_TIMEZONE=America/La_Paz

# Súbelo cada vez que cambies CSS/JS para invalidar la caché del navegador
ASSET_VERSION=1

# ─── Base de datos (hPanel → Bases de datos → MySQL) ───────────────
# En Hostinger el usuario y la base tienen prefijo, ej: u123456789_crm
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
